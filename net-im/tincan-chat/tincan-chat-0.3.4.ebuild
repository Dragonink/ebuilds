DESCRIPTION="Serverless peer-to-peer voice and text chat for your terminal"
HOMEPAGE="https://tincan.rs"
SRC_URI="
	${CARGO_CRATE_URIS}
"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD-2 BSD CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0
	Unicode-DFS-2016 Unlicense WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	media-libs/alsa-lib
	media-libs/opus
"
DEPEND="${RDEPEND}"

src_install() {
	cargo_src_install

	"$(cargo_target_dir)/tincan" completions bash | newbashcomp - tincan
	"$(cargo_target_dir)/tincan" completions fish | newfishcomp - tincan.fish
	"$(cargo_target_dir)/tincan" completions zsh | newzshcomp - _tincan

	einstalldocs
}
