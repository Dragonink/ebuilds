#!/usr/bin/env -S make --file
MAKEFLAGS += --no-builtin-rules --no-builtin-variables

BASENAME ?= basename
NVCHECKER ?= nvchecker
NVCMP ?= nvcmp
NVTAKE ?= nvtake
PQUERY ?= pquery
XARGS ?= xargs

.DEFAULT_GOAL := cmp


.PHONY : .FORCE
.FORCE :

NV_CONFIG := .nvchecker.toml
NV_OLD := .old.ver.json
NV_NEW := .new.ver.json

$(NV_CONFIG) : $(wildcard */*/nvchecker.toml)
	$(file >$@,[__config__])
	$(file >>$@,oldver = "$(NV_OLD)")
	$(file >>$@,newver = "$(NV_NEW)")
	$(if $^,@cat $^ >> $@)

$(NV_OLD) : $(NV_CONFIG) .FORCE
	$(info Updating latest packaged versions...)
	@$(PQUERY) --repo=$(file <profiles/repo_name) --non-live --max --format='{package}={version}' \
	| $(XARGS) $(NVTAKE) --file=$(NV_CONFIG) --ignore-nonexistent

$(NV_NEW) : $(NV_CONFIG) .FORCE
	$(info Fetching new versions...)
	@$(NVCHECKER) --file=$(NV_CONFIG)

.PHONY : take
take : $(NV_OLD)

.PHONY : check
check : $(NV_NEW)

.PHONY : cmp
cmp : $(NV_CONFIG) $(NV_OLD) $(NV_NEW)
	@$(NVCMP) --file=$(NV_CONFIG) --sort=portage
